{
  "name": "arwing",
  "version": "1.0.0",
  "description": "Some useful things for SSBM Fox mains",
  "main": "index.js",
  "scripts": {
    "test": "elm-test",
    "elm:test": "elm-test",
    "elm": "elm make src/Main.elm --output index.js --optimize || true",
    "elm:live": "elm-live src/Main.elm --open --optimize -- --output=elm.js || true",
    "elm:watch": "chokidar '**/*.elm' -c 'npm run elm'",
    "build": "node build.js",
    "start": "npm run elm & electron main.js",
    "watch": "npm run start & npm run elm:watch & wait"
  },
  "author": "",
  "license": "GPL-3.0",
  "dependencies": {
    "chokidar-cli": "^3.0.0",
    "elm": "^0.19.1-5",
    "elm-live": "^4.0.2"
  },
  "devDependencies": {
    "elm-test": "^0.19.1-revision17"
  }
}
